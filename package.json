{
  "name": "url-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test \"tests/integration/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
